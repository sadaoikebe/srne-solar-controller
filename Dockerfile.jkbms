# Lean image for jkbms_api only (parallel stack — not the full srne-app image).
FROM python:3.11-slim

ENV TZ=Asia/Tokyo \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JKBMS_API_HOST=0.0.0.0 \
    JKBMS_API_PORT=5005 \
    JKBMS_CONFIG=/app/jkbms.yaml \
    # Bleak on Linux talks to the *host* bluetoothd via this socket.
    DBUS_SYSTEM_BUS_ADDRESS=unix:path=/var/run/dbus/system_bus_socket

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        tini \
        curl \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-jkbms.txt .
RUN pip install --no-cache-dir -r requirements-jkbms.txt

# API + parallel Influx writer (no modbus / battery_controller).
COPY log_config.py jkbms_client.py jkbms_api.py jkbms_db_writer.py jkbms.yaml ./

EXPOSE 5005

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "jkbms_api.py"]
