# Copy to .env and fill in secrets. Never commit .env.

TZ=Asia/Tokyo
USERNAME=admin
PASSWORD=change-me

INFLUX_ORG=solar
INFLUX_BUCKET=mysolardb
INFLUX_TOKEN=change-me
# Optional: infinite retention on setup (0). Only used at first Influx init.
# INFLUX_RETENTION=0

# Optional Growatt raw uint16 dump (modbus_raw). Leave unset/disabled for normal use.
# INFLUX_BUCKET_RAW=solar_raw

MODBUS_API_PORT=5004
JKBMS_API_PORT=5005
# JKBMS_API_URL=http://127.0.0.1:5005/bms

LOG_LEVEL=INFO

# Optional: GHI grid for overnight_planner (default: Kobe / JMA 神戸).
# PLANNER_LAT=34.6903
# PLANNER_LON=135.1955
